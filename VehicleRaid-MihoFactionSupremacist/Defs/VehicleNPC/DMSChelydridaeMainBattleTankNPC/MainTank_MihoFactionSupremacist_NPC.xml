  <Vehicles.VehicleTurretDef ParentName="DMS_BaseKord">
    <defName>DMS_Chelydridae_Kord</defName>
    <label>heavy machinegun turret</label>
    <!-- 砲塔的渲染顯示 -->
    <gizmoIconTexPath>Things/Vehicles/Chelydridae/DMS_Gun_KordB</gizmoIconTexPath>
