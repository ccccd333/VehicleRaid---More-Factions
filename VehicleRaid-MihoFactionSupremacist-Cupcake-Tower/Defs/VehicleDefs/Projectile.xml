<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseBullet">
    <defName>DMS_Bullet_ChelydridaeShell_VRF_CT_CANNON</defName>
    <label>high-explosive shell</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>4</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>450</damageAmountBase>
      <armorPenetrationBase>1.68</armorPenetrationBase>
      <speed>120</speed>
      <explosionRadius>5.1</explosionRadius>
      <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
      <soundExplode>Explosion_GiantBomb</soundExplode>
      <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
      <soundAmbient>MortarRound_Ambient</soundAmbient>
    </projectile>
  </ThingDef>

  <!-- 鱷龜的主砲砲彈 。由殖民艦隊制式120毫米口徑戰車砲發射的高爆砲彈，這類武器經歷了三千多年的實戰驗證了其設計本身的有效性與可靠性。即使在面對高技術兵器的如今也是一類十分威脅性的重型武裝 -->
  <ThingDef ParentName="BaseBullet">
    <defName>DMS_Bullet_ChelydridaeShell_VRF_CT</defName>
    <label>APT shell</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>30</damageAmountBase>
      <armorPenetrationBase>0.88</armorPenetrationBase>
      <speed>110</speed>
      <explosionRadius>2.1</explosionRadius>
     <!-- <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>-->
      <!--<soundExplode>Explosion_GiantBomb</soundExplode>-->
      <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
      <soundAmbient>MortarRound_Ambient</soundAmbient>
    </projectile>
  </ThingDef>

</Defs>