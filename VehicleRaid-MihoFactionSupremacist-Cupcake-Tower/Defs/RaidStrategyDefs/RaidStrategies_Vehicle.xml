<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<RaidStrategyDef>
		<defName>VRF_Miho_Faction_Supremacist_CT_VehicleAssault</defName>
		<workerClass>VehicleRaidFramework.RaidStrategyWorker_VehicleAssault</workerClass>
		<label>Vehicle Assault</label>
		<description>description.</description>
		<selectionWeightPerPointsCurve>
			<points>
				<li>(2000, 0)</li>
				<li>(10000, 1.0)</li>
				<li>(25000, 3.0)</li>
			</points>
		</selectionWeightPerPointsCurve>
		<pointsFactorCurve>
			<points>
				<li>(0, 1.0)</li>
			</points>
		</pointsFactorCurve>
		<arrivalTextFriendly>arrivalTextFriendly!</arrivalTextFriendly>
		<arrivalTextEnemy>arrivalTextEnemy.</arrivalTextEnemy>
		<letterLabelEnemy>Armored Assault(CupcakeTower)</letterLabelEnemy>
		<arriveModes>
			<li>EdgeWalkIn</li>
		</arriveModes>
		<modExtensions>
			<li Class="VehicleRaidFramework.VehicleRaidExtension">
				<factionDef>Miho_Faction_Supremacist</factionDef>
				<!-- def of the faction that will do the raid -->
				<infantryPointsFraction>0.2</infantryPointsFraction>
				<!-- This controls the spawn rate of pawns on foot and in vehicles, ranging from 0.1 to 1. The lower the value, the more raid points the narrator will use on vehicles and the less on foot pawns. It's recommended to keep this value high because multiple vehicles can block the path of those traveling further back. -->
				<spawnInfantry>true</spawnInfantry>
				<!-- This blocks the spawning of pawns that travel on foot. -->
				<stayTicks>45000</stayTicks>
				<!-- How long will the raid stay on the map -->
				<forcedPawns>
					<!-- This forcibly generates pawns that go on foot; these pawns do not consume raid points from the narrator and ignore the <spawnInfantry>. -->
					<li>Miho_Soldier_TacticalMagi</li>
					<li>Miho_Soldier_MilitiaCaptain</li>
				</forcedPawns>
				<letterLabel>Armored Assault(N.E.O)!</letterLabel>
				<letterText>letterText</letterText>
				<vehicleOptions>
					<li>
						<kindDef>DMS_Chelydridae_MainBattleTank_Miho_Faction_Supremacist_CT_NPC_Kind</kindDef>
						<weight>30</weight>
						<forceCount>1</forceCount>
						<spawnVehicle>true</spawnVehicle>
						<pawnFollowVehicle>true</pawnFollowVehicle>
						<colorConfig>
							<mode>Faction</mode>
							<pattern>Woodland</pattern>
						</colorConfig>
						<cargoItems>
							<li>
								<thingDef>Steel</thingDef>
								<count>8000</count>
							</li>
							<li>
								<thingDef>Uranium</thingDef>
								<count>650</count>
							</li>
							<li>
								<thingDef>Chemfuel</thingDef>
								<count>1500</count>
							</li>
							<li>
								<thingDef>MealSurvivalPack</thingDef>
								<count>11</count>
							</li>
							<li>
								<thingDef>Shell_AntigrainWarhead</thingDef>
								<count>2</count>
							</li>
						</cargoItems>
					</li>
				</vehicleOptions>
			</li>
		</modExtensions>
	</RaidStrategyDef>
</Defs>